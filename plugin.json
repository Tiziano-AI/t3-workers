{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "t3-workers",
  "version": "0.1.0-alpha.1",
  "description": "Orchestrate visible T3 workers from a native Codex or Claude Code chief.",
  "author": {
    "name": "Tiziano AI",
    "url": "https://github.com/Tiziano-AI"
  },
  "homepage": "https://github.com/Tiziano-AI/t3-workers",
  "repository": "https://github.com/Tiziano-AI/t3-workers",
  "license": "MIT",
  "keywords": ["t3-code", "agents", "orchestration", "codex", "claude"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "T3 Workers",
        "shortDescription": "Orchestrate your T3 fleet",
        "developerName": "Tiziano AI",
        "category": "Productivity",
        "defaultPrompt": [
          "Use T3 Workers to inspect my connected fleet before assigning work.",
          "Use T3 Workers to delegate this task and bring back the actual result."
        ]
      }
    }
  }
}
